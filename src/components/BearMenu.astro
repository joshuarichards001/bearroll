---
const links = [
  { href: "/", label: "home" },
  { href: "/about", label: "about" },
  { href: "/stats", label: "stats" },
  { href: "/feeds", label: "feeds" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/"
    ? currentPath === "/"
    : currentPath === href || currentPath.startsWith(`${href}/`);
---

<nav class="flex gap-4" aria-label="Site">
  {
    links.map(({ href, label }) =>
      isCurrent(href) ? (
        <a href={href} class="text-xs text-muted" aria-current="page">
          {label}
        </a>
      ) : (
        <a href={href} class="text-xs text-muted underline">
          {label}
        </a>
      ),
    )
  }
</nav>

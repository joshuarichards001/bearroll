---
import BlogItem from "./BlogItem.astro";
import PostItem from "./PostItem.astro";
import ToastGraph from "./ToastGraph.astro";
import { formatChange, formatCount } from "../lib/format";
import { getAvailableMonths, type Stats } from "../lib/stats";

interface Props {
  stats: Stats;
  activeSlug?: string;
  previous?: Stats;
}

const { stats, activeSlug, previous } = Astro.props;
const weekly = !activeSlug;
const months = getAvailableMonths();

const headline = [
  {
    label: "trending posts",
    value: String(stats.totalPosts),
    change: previous && formatChange(stats.totalPosts, previous.totalPosts),
  },
  {
    label: "unique blogs",
    value: String(stats.uniqueBlogs),
    change: previous && formatChange(stats.uniqueBlogs, previous.uniqueBlogs),
  },
  {
    label: "toasts collected",
    value: formatCount(stats.totalToasts),
    change: previous && formatChange(stats.totalToasts, previous.totalToasts),
  },
];

const baseBtn =
  "text-xs px-2.5 py-1 rounded-sm border no-underline whitespace-nowrap";
const inactiveBtn = "bg-bg-alt border-border text-fg hover:bg-hover";
const activeBtn = "bg-accent border-accent text-white";
---

<nav class="flex gap-2 flex-wrap" aria-label="Stats period">
  <a href="/stats" class:list={[baseBtn, activeSlug ? inactiveBtn : activeBtn]}>
    All Time
  </a>
  {
    months.map((m) => (
      <a
        href={`/stats/${m.slug}`}
        class:list={[baseBtn, activeSlug === m.slug ? activeBtn : inactiveBtn]}
      >
        {m.label}
      </a>
    ))
  }
</nav>

<dl class="flex gap-4 flex-wrap">
  {
    headline.map(({ label, value, change }) => (
      <div class="flex flex-col-reverse">
        <dt class="text-xs text-muted">{label}</dt>
        <dd class="text-2xl font-bold text-heading">
          {value}
          {change && (
            <span class="text-xs font-normal text-muted">({change})</span>
          )}
        </dd>
      </div>
    ))
  }
</dl>
<section>
  <h2 class="text-sm font-bold text-heading mb-2">
    {weekly ? "Weekly" : "Daily"} Toast Activity
  </h2>
  <ToastGraph
    data={weekly ? stats.weeklyToasts : stats.dailyToasts}
    weekly={weekly}
  />
</section>
<section>
  <h2 class="text-sm font-bold text-heading mb-3">Most Toasted Posts</h2>
  <ol class="flex flex-col">
    {stats.topPosts.map((post) => <PostItem post={post} />)}
  </ol>
</section>
<section>
  <h2 class="text-sm font-bold text-heading mb-3">Most Featured Blogs</h2>
  <ol class="flex flex-col">
    {stats.topBlogs.map((blog) => <BlogItem blog={blog} />)}
  </ol>
</section>

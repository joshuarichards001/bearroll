{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bearroll-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "vars": {
    "GITHUB_REPO": "joshuarichards001/bearroll",
    "GITHUB_BRANCH": "master",
  },
  "observability": {
    "enabled": true,
  },
}
